NEXT_PUBLIC_SANITY_PROJECT_ID="<paste your project here>" # Required - The ID of your Sanity project
NEXT_PUBLIC_SANITY_DATASET="production" # Required - The dataset of your Sanity project
NEXT_PUBLIC_SANITY_API_VERSION="2025-09-25" # Optional - The API version provided to the Sanity Client
NEXT_PUBLIC_SANITY_STUDIO_URL="" #Optional, defaults to http://localhost:3333
SANITY_API_READ_TOKEN="<paste your token here>" # Required - The read token for your Sanity project
NEXT_PUBLIC_MAPBOX_TOKEN="<paste your token here>" # Required - The Mapbox token for your project
SANITY_REVALIDATE_SECRET="" # Optional - Secret for the /api/revalidate webhook
NEXT_PUBLIC_SITE_URL="" # Optional - Public origin (https://...), fallback for Settings > Site URL; without either there is no canonical, sitemap or JSON-LD
SANITY_API_WRITE_TOKEN="<paste your token here>" # Required for forms - Server-only token that stores form submissions
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="" # Optional - reCAPTCHA v3 site key. Set BOTH reCAPTCHA keys or neither: with only the secret, every submission fails the check
RECAPTCHA_SECRET_KEY="" # Optional - reCAPTCHA v3 secret key (server-only)
