# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.js

# Compiled Sanity Studio
/dist

# Temporary Sanity runtime, generated by the CLI on every dev server start
/.sanity

# Logs
/logs
*.log

# Coverage directory used by testing tools
/coverage

# Misc
.DS_Store
*.pem

# Typescript
*.tsbuildinfo

# Dotenv and similar local-only files
*.local

# Build output of Sanity Functions (written by the CLI when testing or deploying)
/functions/*/.build

# Miscellaneous
# One-off seeds and migrations are run once and not kept. The two checks that get re-run after
# changing page routing or structured data are the exception. (`scripts/*`, not `scripts`: a
# directory that is ignored whole cannot have files inside it re-included.)
scripts/*
!scripts/verifyPageRouting.ts
!scripts/verifyStructuredData.ts
